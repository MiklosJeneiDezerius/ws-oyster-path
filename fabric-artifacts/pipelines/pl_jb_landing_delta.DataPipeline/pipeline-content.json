{
  "properties": {
    "activities": [
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_load_date",
          "value": {
            "value": "@convertFromUtc(utcNow(), 'Central Europe Standard Time', 'yyyy-MM-dd HH:mm:ss')",
            "type": "Expression"
          }
        },
        "name": "Set v_load_date",
        "dependsOn": []
      },
      {
        "type": "TridentNotebook",
        "typeProperties": {
          "notebookId": "72da4409-1aab-4c93-9a64-b346e3bb07df",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "parameters": {
            "p_root_path": {
              "value": {
                "value": "@concat('Files/', pipeline().parameters.p_root_folder)",
                "type": "Expression"
              },
              "type": "string"
            },
            "p_batch_folder": {
              "value": {
                "value": "@coalesce(pipeline().parameters.p_batch_folder, '')",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        },
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "nb_resolve_landing_batch",
        "dependsOn": [
          {
            "activity": "Set v_load_date",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "formatSettings": {
              "type": "DelimitedTextReadSettings"
            },
            "storeSettings": {
              "type": "LakehouseReadSettings",
              "recursive": false,
              "enablePartitionDiscovery": false
            }
          },
          "datasetSettings": {
            "type": "DelimitedText",
            "typeProperties": {
              "location": {
                "type": "LakehouseLocation",
                "folderPath": "config",
                "fileName": "load_config.csv"
              },
              "columnDelimiter": ",",
              "quoteChar": "\"",
              "escapeChar": "\\",
              "firstRowAsHeader": true
            },
            "schema": [],
            "linkedService": {
              "name": "lh_oyster_path",
              "properties": {
                "type": "Lakehouse",
                "typeProperties": {
                  "artifactId": "210b4538-ea4d-8e62-4e40-be7bf27d086e",
                  "workspaceId": "00000000-0000-0000-0000-000000000000",
                  "rootFolder": "Files"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "lkp_GetLoadConfig",
        "dependsOn": [
          {
            "activity": "nb_resolve_landing_batch",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Filter",
        "typeProperties": {
          "items": {
            "value": "@activity('lkp_GetLoadConfig').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(equals(item().is_active, '1'), equals(item().is_active_delta, '1'))",
            "type": "Expression"
          }
        },
        "name": "Filter - active tables",
        "dependsOn": [
          {
            "activity": "lkp_GetLoadConfig",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@activity('Filter - active tables').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Switch",
              "typeProperties": {
                "on": {
                  "value": "@toLower(trim(item().type))",
                  "type": "Expression"
                },
                "cases": [
                  {
                    "value": "csv",
                    "activities": [
                      {
                        "type": "TridentNotebook",
                        "typeProperties": {
                          "notebookId": "0ffc4433-cfb2-af0b-4c3f-e69c730f3dc7",
                          "workspaceId": "00000000-0000-0000-0000-000000000000",
                          "parameters": {
                            "p_root_path": {
                              "value": {
                                "value": "@concat('Files/', pipeline().parameters.p_root_folder)",
                                "type": "Expression"
                              },
                              "type": "string"
                            },
                            "p_batch_folder": {
                              "value": {
                                "value": "@activity('nb_resolve_landing_batch').output.result.exitValue",
                                "type": "Expression"
                              },
                              "type": "string"
                            },
                            "p_entities": {
                              "value": {
                                "value": "@item().source_object_name",
                                "type": "Expression"
                              },
                              "type": "string"
                            }
                          }
                        },
                        "policy": {
                          "timeout": "0.01:00:00",
                          "retry": 0,
                          "retryIntervalInSeconds": 30,
                          "secureInput": false,
                          "secureOutput": false
                        },
                        "name": "nb_csv_load_source_to_ld",
                        "dependsOn": []
                      }
                    ]
                  },
                  {
                    "value": "json",
                    "activities": [
                      {
                        "type": "TridentNotebook",
                        "typeProperties": {
                          "notebookId": "d7cffd77-c81a-aba4-487b-1656b3a1ed2b",
                          "workspaceId": "00000000-0000-0000-0000-000000000000",
                          "parameters": {
                            "p_batch_folder": {
                              "value": {
                                "value": "@activity('nb_resolve_landing_batch').output.result.exitValue",
                                "type": "Expression"
                              },
                              "type": "string"
                            }
                          }
                        },
                        "policy": {
                          "timeout": "0.01:00:00",
                          "retry": 0,
                          "retryIntervalInSeconds": 30,
                          "secureInput": false,
                          "secureOutput": false
                        },
                        "name": "nb_json_load_source_to_ld",
                        "dependsOn": []
                      }
                    ]
                  }
                ],
                "defaultActivities": [
                  {
                    "type": "Fail",
                    "typeProperties": {
                      "message": {
                        "value": "@concat('Unsupported type ''', item().type, ''' for ', item().source_object_name)",
                        "type": "Expression"
                      },
                      "errorCode": "UNSUPPORTED_SOURCE_TYPE"
                    },
                    "name": "Fail - unknown type",
                    "dependsOn": []
                  }
                ]
              },
              "name": "sw_FileType",
              "dependsOn": []
            }
          ]
        },
        "name": "forEach_FileLoader",
        "dependsOn": [
          {
            "activity": "Filter - active tables",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "p_batch_folder": {
        "type": "string",
        "defaultValue": ""
      },
      "p_root_folder": {
        "type": "string",
        "defaultValue": "landing/oyster"
      }
    },
    "variables": {
      "v_load_date": {
        "type": "String"
      }
    }
  }
}