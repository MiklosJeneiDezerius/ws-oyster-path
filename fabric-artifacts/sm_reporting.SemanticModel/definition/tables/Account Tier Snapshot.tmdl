table 'Account Tier Snapshot'
	lineageTag: 112493c1-c8ff-4fd9-8244-9e0f12c888ed
	sourceLineageTag: [dev_gold].[gold_fct_account_tier_daily_snapshot]

	measure 'Total Cardholders' =
			
			VAR _asOf = [Latest Snapshot Date]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Account Tier Snapshot'[account_id] ),
			        'Date'[calendar_date] = _asOf,
			        KEEPFILTERS ( 'Account Tier Snapshot'[actual_card_status] = "active" )
			    )
		formatString: 0
		displayFolder: _measures
		lineageTag: 6d75388f-12cf-4f27-b2a8-bc482858a6a2

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Latest Snapshot Date' =
			
			CALCULATE (
			    MAX ( 'Account Tier Snapshot'[snapshot_date] ),
			    ALL ( 'Account Tier Snapshot' ),
			    VALUES ( 'Date'[calendar_date] )
			)
		formatString: General Date
		displayFolder: _measures
		lineageTag: 7e77a36a-5bf9-4b4e-9e8f-9a727f4a0cad

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Misaligned Cardholders' =
			
			CALCULATE (
			    [Total Cardholders],
			    KEEPFILTERS ( 'Account Tier Snapshot'[alignment_status] = "misaligned" )
			)
		formatString: 0
		displayFolder: _measures
		lineageTag: 3a13c6f8-2216-4f11-ac2e-b35abe739df7

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Aligned Cardholders' =
			
			CALCULATE (
			    [Total Cardholders],
			    KEEPFILTERS ( 'Account Tier Snapshot'[alignment_status] = "aligned" )
			)
		formatString: 0
		displayFolder: _measures
		lineageTag: f84c6ed1-69e4-47a1-b4d1-39f4ddbbd6b6

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Tier Mismatch Rate' =
			
			DIVIDE ( [Misaligned Cardholders], [Total Cardholders] )
		displayFolder: _measures
		lineageTag: 9859aea7-7079-4da4-8a82-2b2e8844b3e9

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Upgrade Candidates' =
			
			CALCULATE (
			    [Total Cardholders],
			    KEEPFILTERS ( 'Account Tier Snapshot'[upgrade_candidate] = TRUE () )
			)
		formatString: 0
		displayFolder: _measures
		lineageTag: 99f0605a-b4de-4353-845d-333d7f9ea1ca

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Downgrade Candidates' =
			
			CALCULATE (
			    [Total Cardholders],
			    KEEPFILTERS ( 'Account Tier Snapshot'[downgrade_candidate] = TRUE () )
			)
		formatString: 0
		displayFolder: _measures
		lineageTag: bb0fa392-2a72-489e-8e96-2f6f03e04b1e

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Rolling 30-Day Spend' =
			
			VAR _asOf = [Latest Snapshot Date]
			RETURN
			    CALCULATE (
			        SUM ( 'Account Tier Snapshot'[rolling_30_day_spend] ),
			        'Date'[calendar_date] = _asOf
			    )
		displayFolder: _measures
		lineageTag: 7d4ff71d-b110-4398-969f-df8d9b50f362

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Rolling Spend per Cardholder' =
			
			DIVIDE ( [Rolling 30-Day Spend], [Total Cardholders] )
		displayFolder: _measures
		lineageTag: 8397245c-4b58-43ec-819e-40c807d7e4cc

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

